    {
      "action": "create",
      "class": "Script",
      "parent": "ServerScriptService",
      "name": "FinalRealmsSystem",
      "source": "local Players=game:GetService(\"Players\")\nlocal map=workspace:WaitForChild(\"SkyboundMap\")\nlocal areas={{\"VolcanoRealm\",\"FrozenPeaks\",\"VolcanoPortal\"},{\"CelestialCity\",\"VolcanoRealm\",\"CelestialPortal\"},{\"VoidRealm\",\"CelestialCity\",\"VoidPortal\"}}\nfor _,info in ipairs(areas) do\n local name,prev,pn=info[1],info[2],info[3]\n local prompt=map[prev][pn]:WaitForChild(\"TravelPrompt\")\n prompt.Triggered:Connect(function(p)\n  local c=p:FindFirstChild(\"leaderstats\") and p.leaderstats:FindFirstChild(\"SkyCoins\");if not c then return end\n  local key=name..\"Unlocked\";if p:GetAttribute(key)~=true then if c.Value<10 then return end;c.Value-=10;p:SetAttribute(key,true);prompt.ActionText=\"TRAVEL\" end\n  local r=p.Character and p.Character:FindFirstChild(\"HumanoidRootPart\");if r then r.CFrame=CFrame.new(map[name].IslandTop.Position+Vector3.new(0,7,0)) end\n end)\n local folder=map[name]:WaitForChild(\"Orbs\");local busy={}\n for _,o in ipairs(folder:GetChildren()) do o.Touched:Connect(function(hit)\n  local p=Players:GetPlayerFromCharacter(hit.Parent);if not p or busy[o] then return end;local c=p:FindFirstChild(\"leaderstats\") and p.leaderstats:FindFirstChild(\"SkyCoins\");if not c then return end\n  busy[o]=true;c.Value+=1000000;o.Transparency=1;o.CanTouch=false;task.delay(7,function() if o.Parent then o.Transparency=0;o.CanTouch=true;busy[o]=nil end end)\n end) end\n local ep=map[name].EggStand.Egg.HatchPrompt\n ep.Triggered:Connect(function(p)\n  local c=p:FindFirstChild(\"leaderstats\") and p.leaderstats:FindFirstChild(\"SkyCoins\");if not c or c.Value<10 then return end;c.Value-=10\n  local inv=p:FindFirstChild(\"Pets\") or Instance.new(\"Folder\");inv.Name=\"Pets\";inv.Parent=p\n  local v=Instance.new(\"StringValue\");v.Name=name..\" Pet\";v.Value=v.Name;v.Parent=inv;ep.ObjectText=\"HATCHED: \"..v.Name;task.delay(2,function() if ep.Parent then ep.ObjectText=string.upper(name)..\" EGG\" end end)\n end)\nend"
    }
  ]
}