    {
      "action": "create",
      "class": "Script",
      "parent": "ServerScriptService",
      "name": "SkyboundCore",
      "source": "local Players=game:GetService(\"Players\")\nlocal folder=workspace:WaitForChild(\"SkyboundMap\"):WaitForChild(\"SkyCoins\")\nlocal busy={}\nlocal function setup(p)\n local stats=Instance.new(\"Folder\");stats.Name=\"leaderstats\";stats.Parent=p\n local coins=Instance.new(\"IntValue\");coins.Name=\"SkyCoins\";coins.Value=0;coins.Parent=stats\nend\nPlayers.PlayerAdded:Connect(setup)\nfor _,p in ipairs(Players:GetPlayers()) do if not p:FindFirstChild(\"leaderstats\") then setup(p) end end\nfor _,coin in ipairs(folder:GetChildren()) do\n if coin:IsA(\"BasePart\") then coin.Touched:Connect(function(hit)\n  local p=Players:GetPlayerFromCharacter(hit.Parent)\n  if not p or busy[coin] then return end\n  local stats=p:FindFirstChild(\"leaderstats\");local c=stats and stats:FindFirstChild(\"SkyCoins\")\n  if not c then return end\n  busy[coin]=true;c.Value+=1;coin.Transparency=1;coin.CanTouch=false\n  local l=coin:FindFirstChildOfClass(\"PointLight\");if l then l.Enabled=false end\n  task.delay(7,function() if coin.Parent then coin.Transparency=0;coin.CanTouch=true;if l then l.Enabled=true end;busy[coin]=nil end end)\n end) end\nend"
    },
    {
      "action": "create",
      "class": "LocalScript",
      "parent": "StarterPlayer.StarterPlayerScripts",
      "name": "SkyboundHUD",
      "source": "local p=game:GetService(\"Players\").LocalPlayer\nlocal gui=Instance.new(\"ScreenGui\");gui.Name=\"SkyboundHUD\";gui.ResetOnSpawn=false;gui.Parent=p:WaitForChild(\"PlayerGui\")\nlocal box=Instance.new(\"TextLabel\");box.Size=UDim2.fromOffset(230,54);box.Position=UDim2.new(1,-250,0,20);box.BackgroundColor3=Color3.fromRGB(20,30,50);box.BackgroundTransparency=.12;box.TextColor3=Color3.new(1,1,1);box.Font=Enum.Font.GothamBold;box.TextScaled=true;box.Parent=gui\nlocal corner=Instance.new(\"UICorner\");corner.CornerRadius=UDim.new(0,14);corner.Parent=box\nlocal coins=p:WaitForChild(\"leaderstats\"):WaitForChild(\"SkyCoins\")\nlocal function update() box.Text=\"✦  \"..coins.Value..\" SKY COINS\" end\ncoins:GetPropertyChangedSignal(\"Value\"):Connect(update);update()"
    }
