    {
      "action": "create",
      "class": "Script",
      "parent": "ServerScriptService",
      "name": "WaterfallCoinSystem",
      "source": "local Players=game:GetService(\"Players\")\nlocal folder=workspace:WaitForChild(\"SkyboundMap\"):WaitForChild(\"WaterfallIsles\"):WaitForChild(\"WaterfallCoins\")\nlocal busy={} local values={2,2,2,3,3,3,4,4}\nfor i=1,8 do local coin=folder:WaitForChild(\"WaterCoin\"..i)\n coin.Touched:Connect(function(hit)\n  local p=Players:GetPlayerFromCharacter(hit.Parent) if not p or busy[coin] then return end\n  local st=p:FindFirstChild(\"leaderstats\") local c=st and st:FindFirstChild(\"SkyCoins\") if not c then return end\n  busy[coin]=true c.Value+=values[i] or 2 coin.Transparency=1 coin.CanTouch=false\n  local l=coin:FindFirstChildOfClass(\"PointLight\") if l then l.Enabled=false end\n  task.delay(10,function() if coin.Parent then coin.Transparency=0 coin.CanTouch=true if l then l.Enabled=true end busy[coin]=nil end end)\n end)\nend"
