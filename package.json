    {
      "action": "create",
      "class": "Script",
      "parent": "ServerScriptService",
      "name": "FrozenPortalSystem",
      "source": "local portal=workspace:WaitForChild(\"SkyboundMap\"):WaitForChild(\"DesertTemple\"):WaitForChild(\"FrozenPortal\")\nlocal prompt=portal:WaitForChild(\"TravelPrompt\")\nlocal destination=workspace.SkyboundMap:WaitForChild(\"FrozenPeaks\"):WaitForChild(\"IslandTop\")\nprompt.Triggered:Connect(function(player)\n local stats=player:FindFirstChild(\"leaderstats\");local coins=stats and stats:FindFirstChild(\"SkyCoins\")\n if not coins then return end\n if player:GetAttribute(\"FrozenUnlocked\")~=true then\n  if coins.Value<10 then return end\n  coins.Value-=10;player:SetAttribute(\"FrozenUnlocked\",true);prompt.ActionText=\"TRAVEL\"\n end\n local root=player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n if root then root.CFrame=CFrame.new(destination.Position+Vector3.new(0,7,0)) end\nend)"
