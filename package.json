{
  "version": 46,
  "name": "Complete Portal Travel Chain",
  "changes": [
    {
      "action": "create",
      "class": "Script",
      "parent": "ServerScriptService",
      "name": "LateRealmPortalSystem",
      "source": "local map=workspace:WaitForChild(\"SkyboundMap\")\nlocal areas={\n {name=\"FrozenPeaks\",prev=\"DesertTemple\",portal=\"FrozenPortal\"},\n {name=\"VolcanoRealm\",prev=\"FrozenPeaks\",portal=\"VolcanoPortal\"},\n {name=\"CelestialCity\",prev=\"VolcanoRealm\",portal=\"CelestialPortal\"},\n {name=\"VoidRealm\",prev=\"CelestialCity\",portal=\"VoidPortal\"}\n}\nfor _,a in ipairs(areas) do\n local portal=map[a.prev]:WaitForChild(a.portal)\n local prompt=portal:WaitForChild(\"TravelPrompt\")\n prompt.Triggered:Connect(function(player)\n  local stats=player:FindFirstChild(\"leaderstats\");local coins=stats and stats:FindFirstChild(\"SkyCoins\");if not coins then return end\n  local key=a.name..\"Unlocked\"\n  if player:GetAttribute(key)~=true then\n   if coins.Value<10 then return end\n   coins.Value-=10;player:SetAttribute(key,true);prompt.ActionText=\"TRAVEL\"\n  end\n  local root=player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n  if root then root.CFrame=CFrame.new(map[a.name].IslandTop.Position+Vector3.new(0,7,0)) end\n end)\nend"
    },
