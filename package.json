    {
      "action": "create",
      "class": "Script",
      "parent": "ServerScriptService",
      "name": "WaterfallOrbSystem",
      "source": "local Players=game:GetService(\"Players\")\nlocal folder=workspace:WaitForChild(\"SkyboundMap\"):WaitForChild(\"WaterfallIsles\"):WaitForChild(\"WaterfallCoins\")\nlocal busy={}\nfor _,orb in ipairs(folder:GetChildren()) do\n if orb:IsA(\"BasePart\") then\n  orb.Touched:Connect(function(hit)\n   local p=Players:GetPlayerFromCharacter(hit.Parent)\n   if not p or busy[orb] then return end\n   local stats=p:FindFirstChild(\"leaderstats\");local coins=stats and stats:FindFirstChild(\"SkyCoins\")\n   if not coins then return end\n   busy[orb]=true;coins.Value+=5000000\n   orb.Transparency=1;orb.CanTouch=false\n   local light=orb:FindFirstChildOfClass(\"PointLight\");if light then light.Enabled=false end\n   task.delay(8,function()\n    if orb.Parent then orb.Transparency=0;orb.CanTouch=true;if light then light.Enabled=true end;busy[orb]=nil end\n   end)\n  end)\n end\nend"
