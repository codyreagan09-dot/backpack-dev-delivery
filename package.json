      "name": "LateRealmReturnPortalSystem",
      "source": "local map=workspace:WaitForChild(\"SkyboundMap\")\nlocal pairs={{\"FrozenPeaks\",\"DesertTemple\"},{\"VolcanoRealm\",\"FrozenPeaks\"},{\"CelestialCity\",\"VolcanoRealm\"},{\"VoidRealm\",\"CelestialCity\"}}\nfor _,x in ipairs(pairs) do\n local area,prev=x[1],x[2];local portal=map[area]:WaitForChild(\"ReturnPortal\");local prompt=portal:WaitForChild(\"TravelPrompt\")\n prompt.Triggered:Connect(function(p) local r=p.Character and p.Character:FindFirstChild(\"HumanoidRootPart\");if r then r.CFrame=CFrame.new(map[prev].IslandTop.Position+Vector3.new(0,7,0)) end end)\nend"
